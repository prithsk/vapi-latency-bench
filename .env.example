# Vapi dashboard > API Keys. Use the PRIVATE key.
VAPI_API_KEY=
# Vapi dashboard > Phone Numbers > Create Phone Number (free). Make TWO.
# Number 1 is the one the bench dials. The script attaches the scripted caller to it.
VAPI_CALLEE_NUMBER_ID=
VAPI_CALLEE_NUMBER=+1
# Number 2 is the one the bench dials FROM for the "vapi" configs.
VAPI_FROM_NUMBER_ID=
# Optional. A Twilio number imported into Vapi, for the "twilio" configs.
VAPI_FROM_TWILIO_NUMBER_ID=
